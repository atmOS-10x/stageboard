{
  "name": "stageboard",
  "version": "0.1.0",
  "description": "Render every component and page of your app on one canvas, inspect anything, and ask an agent for live variants.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stageboard": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./next": {
      "types": "./dist/node/next.d.ts",
      "default": "./dist/node/next.js"
    },
    "./shims/next/*": "./dist/shims/next/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "cac": "^7.0.1",
    "chokidar": "^5.0.0",
    "es-module-lexer": "^1.7.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
