{
  "name": "@atmos.build/stageboard",
  "version": "0.1.0",
  "description": "Every screen, flow and component of your React app on one board. Point at what's wrong; your agent changes the real code, optionally as live variants.",
  "license": "MIT",
  "homepage": "https://stageboard.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atmOS-10x/stageboard.git",
    "directory": "packages/stageboard"
  },
  "bugs": {
    "url": "https://github.com/atmOS-10x/stageboard/issues"
  },
  "keywords": [
    "react",
    "storybook",
    "design",
    "agents",
    "claude-code",
    "codex",
    "mcp",
    "vite",
    "nextjs",
    "variants",
    "flows"
  ],
  "type": "module",
  "bin": {
    "stageboard": "dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./next": {
      "types": "./dist/node/next.d.ts",
      "default": "./dist/node/next.js"
    },
    "./shims/next/*": "./dist/shims/next/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build && node scripts/prepack.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cac": "^7.0.1",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "es-module-lexer": "^1.7.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
