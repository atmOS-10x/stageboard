{
  "name": "stageboard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "dev": "pnpm -r --filter ./packages/* --parallel dev",
